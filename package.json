{
	"name": "commup",
	"description": "CommUp — Completions & Commissioning Management System (SaaS multi-tenant).",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.92.0",
		"@opennextjs/cloudflare": "1.18.1",
		"@supabase/ssr": "^0.9.0",
		"@supabase/supabase-js": "^2.100.1",
		"clsx": "^2.1.1",
		"fflate": "0.8.3",
		"html5-qrcode": "^2.3.8",
		"lucide-react": "^1.11.0",
		"next": "16.3.4",
		"next-intl": "4.14.2",
		"pdf-lib": "^1.17.1",
		"qrcode-generator": "^2.0.4",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-pdf": "^10.4.1",
		"recharts": "^3.8.1",
		"tailwind-merge": "^3.5.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@tailwindcss/postcss": "4.1.17",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"esbuild": "^0.27.7",
		"eslint": "9.39.2",
		"eslint-config-next": "^16.3.4",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"fake-indexeddb": "^6.2.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"tailwindcss": "4.1.17",
		"tsx": "^4.21.0",
		"typescript": "5.9.3",
		"vitest": "^5.0.0",
		"wrangler": "^4.128.0"
	},
	"overrides": {
		"@swc/helpers": "^0.5.21"
	},
	"private": true,
	"scripts": {
		"build": "next build",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
		"check": "npm run lint && npm run typecheck && npm test && npm run build",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"dev": "next dev",
		"lint": "eslint .",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"help:build": "node scripts/docs/build-help.mjs",
		"prepare": "husky",
		"test": "vitest run --project unit",
		"test:db": "node scripts/db-tests/run.mjs",
		"demo:reset": "node scripts/demo/reset.mjs",
		"test:watch": "vitest",
		"e2e": "node scripts/e2e/run.mjs"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --max-warnings=9999"
	}
}
