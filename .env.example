# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (acciones con service role, crons, scripts). Nunca en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: Cloudflare Web Analytics
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Web push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@commup.app

# --- Crons (/api/cron/*) ---
CRON_SECRET=

# --- IA (Claude) ---
ANTHROPIC_API_KEY=

# --- Paquete de handover: clave Ed25519 PKCS#8 en base64 ---
HANDOVER_ED25519_PRIVATE_KEY=

# --- Leads de la landing ---
LEADS_IP_SALT=
LEAD_NOTIFY_USER_ID=

# --- Scripts (scripts/demo-data, conector de pruebas) ---
DEMO_USER_PASSWORD=
COMMUP_API_KEY=
COMMUP_WEBHOOK_SECRET=

# --- Tests de BD (tests/db) ---
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_PROJECT_A_ID=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
