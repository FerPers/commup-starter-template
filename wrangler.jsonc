/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "commup-starter-template",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	// S15 (A-13): límite de peticiones de la API v1 por API key (y por IP para claves inválidas).
	// 600 por minuto por clave; ver src/lib/api/rate-limit.ts.
	"ratelimits": [
		{ "name": "API_RATE_LIMITER", "namespace_id": "1501", "simple": { "limit": 600, "period": 60 } }
	],
	"upload_source_maps": true
	// Cron schedules live in .github/workflows/cron.yml (GitHub Actions hits
	// /api/cron/* via HTTPS). OpenNext does not emit a `scheduled` handler
	// so a wrangler cron fires into a no-op.
}
