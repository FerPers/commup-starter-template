    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/field-capture.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Campo: Captura ITR con QR"
    },
    {
      "src": "/screenshots/dashboard.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard de Completions"
    }
  ],
  "shortcuts": [
    {
      "name": "Escanear Tag",
      "short_name": "Scan QR",
      "description": "Escanear tag QR/NFC de equipo",
      "url": "/scan",
      "icons": [{ "src": "/icons/qr-shortcut.png", "sizes": "96x96" }]
    },
    {
      "name": "Mis ITRs",
      "short_name": "ITRs",
      "description": "Ver ITRs asignados",
      "url": "/itrs/assigned",
      "icons": [{ "src": "/icons/itr-shortcut.png", "sizes": "96x96" }]
    },
    {
      "name": "Punch List",
      "short_name": "Punches",
      "description": "Punch List activo",
      "url": "/punches",
      "icons": [{ "src": "/icons/punch-shortcut.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "commup",
      "url": "/handle?url=%s"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
